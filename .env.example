DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-this-to-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=qlks
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-address@example.com
EMAIL_HOST_PASSWORD=your-provider-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=An Nhien Hotel <your-address@example.com>

MOMO_PARTNER_CODE=your-momo-sandbox-partner-code
MOMO_ACCESS_KEY=your-momo-sandbox-access-key
MOMO_SECRET_KEY=your-momo-sandbox-secret-key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://your-public-https-domain/thanh-toan/momo/return/
MOMO_IPN_URL=https://your-public-https-domain/thanh-toan/momo/ipn/
